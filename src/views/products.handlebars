<h1 class="page-title">Lista de productos - Mongo DB</h1>

<div class="container">
  <div class="product-grid">
    {{#each products}}
      <div class="product-card">
        <h3 class="product-title">{{this.title}}</h3>
        <p><strong>Descripción:</strong> {{this.description}}</p>
        <p><strong>Precio:</strong> ${{this.price}}</p>
        <p><strong>Categoría:</strong> {{this.category}}</p>

        <div class="product-buttons">
          <a href="/products/{{this._id}}" class="btn btn-detail">Ver detalle</a>

          <form action="/api/carts/67f4594c6e62ca7572b6525b/product/{{this._id}}" method="POST"
                onsubmit="event.preventDefault(); fetch(this.action, {method:'POST'}).then(() => location.href='/carts/67f4594c6e62ca7572b6525b')">
            <button class="btn btn-add" type="submit">Agregar al carrito</button>
          </form>
        </div>
      </div>
    {{/each}}
  </div>
</div>

<div class="pagination">
  {{#if hasPrevPage}}
    <a class="page-link" href="?page={{prevPage}}">⬅ Página anterior</a>
  {{/if}}
  <span class="page-number">Página {{currentPage}}</span>
  {{#if hasNextPage}}
    <a class="page-link" href="?page={{nextPage}}">Página siguiente ➡</a>
  {{/if}}
</div>