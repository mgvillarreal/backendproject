<h1 class="cart-title">Carrito de Compras</h1>
<h2 class="cart-title">ID: 67f4594c6e62ca7572b6525b</h2>

<div class="cart-container">
  {{#if cart.products.length}}
    <ul class="cart-list">
      {{#each cart.products}}
        <li class="cart-item">
          <div>
            <h2 class="product-title">{{this.product.title}}</h2>
            <p class="product-description">{{this.product.description}}</p>
            <p><strong>Precio:</strong> ${{this.product.price}}</p>
            <p><strong>Categoría:</strong> {{this.product.category}}</p>
            <p><strong>Cantidad:</strong> {{this.quantity}}</p>
          </div>
        </li>
      {{/each}}
    </ul>
  {{else}}
    <p class="empty-cart">No hay productos en el carrito.</p>
  {{/if}}

  <div class="back-link">
    <a href="/products">← Seguir comprando</a>
  </div>
</div>