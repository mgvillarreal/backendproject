<h1 class="text-2xl font-bold mb-4">Carrito: {{cartId}}</h1>

{{#if products.length}}
  <ul class="space-y-4">
    {{#each products}}
      <li class="p-4 bg-gray-100 rounded shadow">
        <h2 class="text-xl font-semibold">{{this.product.title}}</h2>
        <p>{{this.product.description}}</p>
        <p>Precio: ${{this.product.price}}</p>
        <p>Categoría: {{this.product.category}}</p>
        <p>Cantidad: {{this.quantity}}</p>
      </li>
    {{/each}}
  </ul>
{{else}}
  <p>No hay productos en el carrito.</p>
{{/if}}